# ---------------------------------------------------------------------------
# GDG Noida Volunteer Directory: environment variables
# Copy this file to .env.local for local development and fill in the values.
# Never commit .env.local or any file containing real keys.
# ---------------------------------------------------------------------------

# Canonical public URL of the directory. This exact value is encoded in the master
# QR code, so set it to the final production domain BEFORE printing ID cards.
# NEXT_PUBLIC_* values are inlined at build time: redeploy after changing it.
# Local development: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase project URL and public (anon / publishable) key.
# Found in Supabase Dashboard > Project Settings > API.
# The anon key is safe to expose to the browser because Row Level Security protects the data.
NEXT_PUBLIC_SUPABASE_URL=lhnjnfaonaayexxsjvxe
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImxobmpuZmFvbmFheWV4eHNqdnhlIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODk5NjE3MzksImV4cCI6MjEwNTUzNzczOX0.g5LVBwa5Kzg0HEROPlfX-nlL9Hx-HD1M3aUJSGKKoeA

# Optional: address shown on the privacy page for profile removal / correction requests.
NEXT_PUBLIC_CONTACT_EMAIL=

# NOTE: this app never needs the Supabase service-role key. Do not add it here.
# ---------------------------------------------------------------------------
# SERVER ONLY
# ---------------------------------------------------------------------------
# Supabase service-role key.
#
# NEVER expose this to the browser.
# NEVER prefix it with NEXT_PUBLIC_.
# Add the real value only to local .env.local and Vercel server environment.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImxobmpuZmFvbmFheWV4eHNqdnhlIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc4OTk2MTczOSwiZXhwIjoyMTA1NTM3NzM5fQ.1flymSq7z7InvYHB5pmt4ud4qWCIdiBUF0cmgUj6DIk
